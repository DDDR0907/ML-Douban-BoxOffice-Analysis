# 1. 操作系统生成的垃圾文件
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 2. Python 缓存和编译文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 3. 虚拟环境（非常重要，绝对不能传！）
venv/
env/
.env/
Pipfile.lock

# 4. 敏感信息和本地环境变量
.env
*.local
secrets.json

# 5. IDE 和编辑器配置
.idea/
.vscode/
*.swp

# 6. 机器学习 / 数据科学专属（按需开启）
# 忽略庞大的原始数据集
*.csv
*.tsv
*.dat
*.jsonl
# 忽略训练生成的模型权重（体积巨大）
*.pt
*.pth
*.h5
*.xgb
*.pkl
# 忽略 Jupyter 缓存
.ipynb_checkpoints/